# NatureDataCube API token (required)
NDC_TOKEN=your_token_here
# AgroDataCube API token (optional: without it Weather, Soil map, AHN and Agricultural fields are disabled)
ADC_TOKEN=gettokenat_https://ndc-test.containers.wur.nl
# Path under which a reverse proxy publishes the app (optional)
SHINY_APP_BASE_URL=/naturedatacube
# Retrievals run in background processes, so that a long one does not hold the other users up (optional;
# the default is true in the container). NDC_WORKERS is the number of retrievals at the same time (default: up to 4).
# NDC_ASYNC=true
# NDC_WORKERS=4
# Longest retrieval that is accepted, in seconds (optional; default 900 in the background mode, else 300)
# NDC_MAX_REQUEST_SECONDS=900
# Largest upload in MB (optional, default 100)
# NDC_MAX_UPLOAD_MB=100
